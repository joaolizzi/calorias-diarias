# Copie este arquivo para .env e preencha com suas credenciais Supabase.
# Chaves VITE_ são usadas pelo navegador; a service role NUNCA deve ter prefixo VITE_.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key
VITE_ADMIN_EMAIL=joaopedrolizzi@outlook.com

# --- Gemini (server-only) ---
GEMINI_API_KEY=sua_chave_gemini
GEMINI_MODEL=gemini-1.5-flash

# --- Serverless /api ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_anon_key

# MUITO IMPORTANTE: chave service_role, somente no ambiente do servidor/Vercel.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# E-mail com acesso ao painel /admin.
ADMIN_EMAIL=joaopedrolizzi@outlook.com
